generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id          String     @id @default(cuid())
  name        String
  email       String
  budgetRange String
  message     String
  status      LeadStatus @default(NEW)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}
